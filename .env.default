# Local environment defaults. Copy to .env (gitignored) and uncomment what differs
# on your machine. Both docker compose and the Makefile read .env. Values are bare
# KEY=value, no quotes.

# Neo4j the API connects to. Default: the compose container.
# Home lab: CBX_NEO4J_URI=bolt://10.0.0.117:7687 plus its user and password.
#CBX_NEO4J_URI=bolt://127.0.0.1:27687
#CBX_NEO4J_USER=neo4j
#CBX_NEO4J_PASSWORD=cbx-dev-password

# Host ports of the compose Neo4j (bolt and browser). Not 7687/7474 so it never
# collides with another Neo4j on the machine.
#CBX_NEO4J_BOLT_PORT=27687
#CBX_NEO4J_HTTP_PORT=27474

# Port for the API and the web UI.
#CBX_PORT=2727

# Tests use their own Neo4j (compose service neo4j-test, no volume) and wipe every
# Resource node in it. They refuse a non-local URI unless CBX_TEST_ALLOW_REMOTE=1.
#CBX_TEST_NEO4J_BOLT_PORT=27688
#CBX_TEST_NEO4J_URI=bolt://127.0.0.1:27688
#CBX_TEST_NEO4J_PASSWORD=cbx-test-password